{#- Illustrative manager portal. Values are placeholders, not client data. -#}
<div class="dash" aria-label="Illustrative InspectX manager dashboard" role="img">
  <div class="dash-top"><span class="lights"><i></i><i></i><i></i></span><span class="url">inspectx · manager portal</span><span>Illustrative data</span></div>
  <div class="dash-body">
    <div class="dash-side">
      <span class="on">{% icon "gauge" %} Dashboard</span>
      <span>{% icon "clipboard-list" %} Equipment</span>
      <span>{% icon "file-text" %} Forms</span>
      <span>{% icon "chart-column" %} Reports</span>
      <span>{% icon "folder-check" %} Documents</span>
    </div>
    <div class="dash-main">
      <div class="dash-sites">
        {%- for site_ in [["Site 1",82,12,6],["Site 2",74,16,10],["Site 3",90,7,3],["Site 4",68,20,12]] %}
        <div class="dash-site"><span class="s-label">{{ site_[0] }}</span>
          <span class="stack-bar"><i class="p" data-w="{{ site_[1] }}"></i><i class="r" data-w="{{ site_[2] }}"></i><i class="d" data-w="{{ site_[3] }}"></i></span>
        </div>
        {%- endfor %}
      </div>
      <div class="dash-legend"><span class="pill pill-ok">Pass</span><span class="pill pill-warn">Repaired</span><span class="pill pill-bad">Defect</span></div>
      <div class="dash-scroll">
        <table class="dash-table">
          <thead><tr><th>Tag</th><th>Equipment</th><th>Type</th><th>Zone</th><th>Outcome</th></tr></thead>
          <tbody>
            <tr><td>LCS-014</td><td>Local control station</td><td>Visual</td><td>Zone 1</td><td><span class="pill pill-ok">Pass</span></td></tr>
            <tr><td>DB-203</td><td>Distribution board</td><td>Close</td><td>Zone 2</td><td><span class="pill pill-warn">Repaired</span></td></tr>
            <tr><td>LF-071</td><td>Light fitting</td><td>Detailed</td><td>Zone 1</td><td><span class="pill pill-bad">Defect</span></td></tr>
            <tr><td>JB-118</td><td>Junction box</td><td>Visual</td><td>Zone 2</td><td><span class="pill pill-ok">Pass</span></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
