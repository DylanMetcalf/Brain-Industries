{#- Service explorer: honeycomb of bespoke symbols; one service in focus at a time, cycling automatically. -#}
{% from "partials/symbols.njk" import sym %}
<div class="sx" data-sx>
  <div class="hive-wrap">
    <div class="hive" role="tablist" aria-label="Services and products">
      {%- for s in services %}
      {%- if loop.index0 % 2 == 0 %}<div class="hive-col">{% endif %}
      <button class="hx hx-{{ s.group }}" type="button" role="tab" id="sxt-{{ s.slug }}" aria-controls="sxp-{{ s.slug }}" aria-selected="{{ 'true' if loop.first else 'false' }}" data-sx-tab>
        <span class="hx-in">
          {{ sym(s.slug, "hx-sym") }}
          <span class="hx-label">{{ s.label }}</span>
        </span>
      </button>
      {%- if loop.index0 % 2 == 1 or loop.last %}</div>{% endif %}
      {%- endfor %}
    </div>
    <p class="hive-legend"><span class="lg lg-service"></span> Services <span class="lg lg-product"></span> Products</p>
  </div>
  <div class="sx-stage">
    {%- for s in services %}
    <article class="sx-panel{% if loop.first %} is-active{% endif %}" role="tabpanel" id="sxp-{{ s.slug }}" aria-labelledby="sxt-{{ s.slug }}"{% if not loop.first %} data-hide{% endif %}>
      <span class="sx-bar" aria-hidden="true"><i></i></span>
      <div class="sx-copy">
        <p class="sx-kicker"><span class="sx-badge sx-badge-{{ s.group }}">{{ sym(s.slug) }}</span><span>{{ "Service" if s.group == "service" else "Product supply" }} · {{ "S" if s.group == "service" else "P" }}-{{ ((services | byGroup(s.group)).indexOf(s) + 1) | pad }}</span></p>
        <h3>{{ s.title }}</h3>
        <p class="sx-lead">{{ s.short }}</p>
        <ul class="sx-points">
          {%- for pt in s.points.slice(0, 3) %}<li>{% icon "check" %}<span>{{ pt }}</span></li>{% endfor %}
        </ul>
        <div class="btn-row">
          <a class="btn btn-primary" href="/services/{{ s.slug }}/">Explore {{ "service" if s.group == "service" else "product" }} {% icon "arrow-right" %}</a>
          <a class="btn" href="/contact/?enquiry={{ s.slug }}#enquiry">Enquire</a>
        </div>
      </div>
      <div class="sx-media{% if s.imageFit == 'contain' %} contain{% endif %}">
        {%- if s.image %}
          {% image s.image, s.imageAlt, "(min-width: 62em) 460px, 100vw" %}
        {%- elif s.slug == "hazardous-area-classification" %}
          <div class="sx-art">{% include "partials/zone-art.njk" %}</div>
        {%- else %}
          <div class="sx-art sx-art-icon">{{ sym(s.slug) }}</div>
        {%- endif %}
      </div>
    </article>
    {%- endfor %}
  </div>
</div>
